<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:elevation="4dp"
        app:title="Bills"
        app:titleTextColor="@android:color/white"
        app:navigationIcon="@drawable/ic_back"/>

    <!-- Container for content with padding -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toolbar"
        android:padding="16dp">

        <!-- Optional Filters -->
        <LinearLayout
            android:id="@+id/layoutFilters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Example: Filter by Payment Method -->
            <Spinner
                android:id="@+id/spinnerPaymentMethodFilter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginRight="8dp"/>

            <!-- Example: Filter by Date Range (just a button to show a DatePicker) -->
            <Button
                android:id="@+id/buttonDateFilter"
                android:layout_width="wrap_content"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Select Date"/>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewBills"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/layoutFilters"
            android:layout_marginTop="8dp"/>

        <ProgressBar
            android:id="@+id/progressBarLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true" />

        <!-- If no bills are found -->
        <TextView
            android:id="@+id/textViewNoBills"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No bills found"
            android:layout_centerInParent="true"
            android:visibility="gone"/>

    </RelativeLayout>

</RelativeLayout>