<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Rice Bag Name and Size -->
        <TextView
            android:id="@+id/textViewLoadedNameSize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Name: Basmati - 5kg"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/colorOnSurface" />

        <!-- Quantity Loaded -->
        <TextView
            android:id="@+id/textViewLoadedQuantity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quantity: 50"
            android:textSize="14sp"
            android:textColor="@color/colorOnSurface"
            android:layout_marginTop="4dp" />

        <!-- Price per Unit -->
        <TextView
            android:id="@+id/textViewLoadedPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Price per Unit: \$100.00"
            android:textSize="14sp"
            android:textColor="@color/colorOnSurface"
            android:layout_marginTop="4dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
