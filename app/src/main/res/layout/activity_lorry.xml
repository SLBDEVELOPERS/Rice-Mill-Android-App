<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coordinatorLayoutLorry"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <!-- Material Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBarLorry"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:title="Lorry Management"
        app:titleTextColor="@color/white"
        android:titleTextColor="@color/colorOnPrimary"
        app:navigationIcon="@drawable/ic_back"
        />

    <!-- Content Layout -->
    <ScrollView
        android:id="@+id/scrollViewLorry"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="?attr/actionBarSize"
        android:padding="16dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Spinner to Select Rice Bags -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textInputLayoutRiceBags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Select Rice Bag"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="@color/colorPrimary">

                <Spinner
                    android:id="@+id/spinnerRiceBags"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:spinnerMode="dropdown" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Available Stock Display -->
            <TextView
                android:id="@+id/textViewAvailableStock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Available Stock: N/A"
                android:textSize="14sp"
                android:textColor="@color/colorOnSurface"
                android:layout_marginTop="8dp" />

            <!-- Quantity Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textInputLayoutQuantity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Quantity"
                android:layout_marginTop="16dp"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="@color/colorPrimary">

                <EditText
                    android:id="@+id/editTextQuantity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:padding="12dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Load to Lorry Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonLoad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Load to Lorry"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/colorPrimary"
                android:textColor="@color/colorOnPrimary"
                app:cornerRadius="8dp" />

            <!-- Loaded Rice Bags Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loaded Rice Bags:"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp"
                android:textColor="@color/colorOnSurface" />

            <!-- RecyclerView for Loaded Rice Bags -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewLoadedBags"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="8dp"
                android:clipToPadding="false"
                android:scrollbars="vertical" />

            <!-- Restock Leftover Bags Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonRestock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Restock Leftover Bags"
                android:layout_marginTop="16dp"
                android:layout_gravity="center_horizontal"
                android:backgroundTint="@color/colorSecondary"
                android:textColor="@color/colorOnSecondary"
                app:cornerRadius="8dp" />

        </LinearLayout>

    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
