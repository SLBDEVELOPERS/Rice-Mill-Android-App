<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="15dp"
    android:elevation="0dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Shop Name -->
        <TextView
            android:id="@+id/textViewShopName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Shop Name"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/colorOnSurface" />

        <!-- Shop Address -->
        <TextView
            android:id="@+id/textViewShopAddress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Address: 123 Street"
            android:textSize="14sp"
            android:textColor="@color/colorOnSurface"
            android:layout_marginTop="4dp" />

        <!-- Shop Contact -->
        <TextView
            android:id="@+id/textViewShopContact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Contact: 0123456789"
            android:textSize="14sp"
            android:textColor="@color/colorOnSurface"
            android:layout_marginTop="4dp" />

        <!-- Outstanding Due -->
        <TextView
            android:id="@+id/textViewShopDue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Outstanding Due: Rs 0.00"
            android:textSize="14sp"
            android:textColor="@color/colorPrimary"
            android:layout_marginTop="8dp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
