<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <Spinner
            android:id="@+id/spinnerShops"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:prompt="@string/select_shop" />

        <Spinner
            android:id="@+id/spinnerLoadedRiceBags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:prompt="@string/select_rice_bag_size"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/editTextLoadQuantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/enter_quantity"
            android:inputType="number"
            android:layout_marginTop="8dp" />

        <!-- Payment Method Selection -->
        <TextView
            android:id="@+id/textViewPaymentMethod"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/select_payment_method"
            android:textSize="16sp"
            android:layout_marginTop="16dp" />

        <RadioGroup
            android:id="@+id/radioGroupPaymentMethod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <RadioButton
                android:id="@+id/radioCash"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cash" />

            <RadioButton
                android:id="@+id/radioCheque"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cheque"
                android:layout_marginStart="16dp" />

            <RadioButton
                android:id="@+id/radioCredit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/credit"
                android:layout_marginStart="16dp" />
        </RadioGroup>

        <!-- Additional Payment Details -->
        <LinearLayout
            android:id="@+id/layoutChequeDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="8dp">

            <EditText
                android:id="@+id/editTextChequeNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter Cheque Number"
                android:inputType="text" />

            <EditText
                android:id="@+id/editTextBankName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter Bank Name"
                android:inputType="text"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutCreditDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="8dp">

            <EditText
                android:id="@+id/editTextCreditTerm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter Credit Term Days"
                android:inputType="number" />
        </LinearLayout>

        <Button
            android:id="@+id/buttonAddToCart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add_to_cart"
            android:layout_marginTop="16dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewCart"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/buttonIssueAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/issue_all"
            android:layout_marginTop="16dp" />

    </LinearLayout>
</ScrollView>
